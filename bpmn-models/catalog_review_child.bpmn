<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  id="Definitions_CatalogReview"
  targetNamespace="https://marketplace.onboarding/catalog"
  exporter="Camunda Modeler"
  exporterVersion="5.0.0">

  <bpmn:process id="Process_CatalogReview" name="Catalog Review" isExecutable="true">

    <bpmn:startEvent id="StartEvent_CatalogReview" name="Catalog Review Started">
      <bpmn:outgoing>Flow_CatalogStart_to_Upload</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Upload Product Catalog -->
    <bpmn:userTask id="Task_UploadCatalog" name="Upload Product Catalog">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="=sellerEmail" />
        <zeebe:formDefinition formKey="camunda-forms:bpmn:Form_CatalogUpload" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CatalogStart_to_Upload</bpmn:incoming>
      <bpmn:outgoing>Flow_Upload_to_ValidateMulti</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Multi-Instance Sequential Sub-Process: Validate Each Product -->
    <bpmn:subProcess id="SubProcess_ValidateProducts" name="Validate Products (Sequential Multi-Instance)">
      <bpmn:incoming>Flow_Upload_to_ValidateMulti</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateMulti_to_GW_Valid</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics
            inputCollection="=productItems"
            inputElement="productItem"
            outputCollection="validationResults"
            outputElement="=validationResult" />
        </bpmn:extensionElements>
        <bpmn:completionCondition>=every item in validationResults satisfies item.catalogValid = true</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartEvent_ValidateProduct" name="Start Product Validation">
        <bpmn:outgoing>Flow_ValProdStart_to_ServiceTask</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:serviceTask id="Task_ValidateSingleProduct" name="Validate Product Data">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="validate-product-catalog" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=productItem.productId" target="productId" />
            <zeebe:output source="=catalogValid" target="catalogValid" />
            <zeebe:output source="=validationErrors" target="validationErrors" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ValProdStart_to_ServiceTask</bpmn:incoming>
        <bpmn:outgoing>Flow_ServiceTask_to_ValGW</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="GW_ProductValid" name="Product valid?">
        <bpmn:incoming>Flow_ServiceTask_to_ValGW</bpmn:incoming>
        <bpmn:outgoing>Flow_ProdValid_to_End</bpmn:outgoing>
        <bpmn:outgoing>Flow_ProdInvalid_to_Correct</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:userTask id="Task_CorrectProductData" name="Correct Product Data">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition assignee="=sellerEmail" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ProdInvalid_to_Correct</bpmn:incoming>
        <bpmn:outgoing>Flow_Correct_to_Revalidate</bpmn:outgoing>
      </bpmn:userTask>

      <bpmn:serviceTask id="Task_RevalidateProduct" name="Re-validate Product">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="validate-product-catalog" retries="2" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Correct_to_Revalidate</bpmn:incoming>
        <bpmn:outgoing>Flow_Revalidate_to_End</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="EndEvent_ProductValidated" name="Product Validated">
        <bpmn:incoming>Flow_ProdValid_to_End</bpmn:incoming>
        <bpmn:incoming>Flow_Revalidate_to_End</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_ValProdStart_to_ServiceTask" sourceRef="StartEvent_ValidateProduct" targetRef="Task_ValidateSingleProduct" />
      <bpmn:sequenceFlow id="Flow_ServiceTask_to_ValGW" sourceRef="Task_ValidateSingleProduct" targetRef="GW_ProductValid" />
      <bpmn:sequenceFlow id="Flow_ProdValid_to_End" name="=catalogValid = true" sourceRef="GW_ProductValid" targetRef="EndEvent_ProductValidated">
        <bpmn:conditionExpression>=catalogValid = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ProdInvalid_to_Correct" name="=catalogValid = false" sourceRef="GW_ProductValid" targetRef="Task_CorrectProductData">
        <bpmn:conditionExpression>=catalogValid = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Correct_to_Revalidate" sourceRef="Task_CorrectProductData" targetRef="Task_RevalidateProduct" />
      <bpmn:sequenceFlow id="Flow_Revalidate_to_End" sourceRef="Task_RevalidateProduct" targetRef="EndEvent_ProductValidated" />
    </bpmn:subProcess>

    <!-- Gateway: Catalog fully valid? -->
    <bpmn:exclusiveGateway id="GW_CatalogApproved" name="Catalog Approved?">
      <bpmn:incoming>Flow_ValidateMulti_to_GW_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_CatalogApproved_to_ReviewTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_CatalogRejected_to_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Gateway: Ops review tasks run simultaneously -->
    <bpmn:parallelGateway id="GW_ParallelReview" name="Start Parallel Review">
      <bpmn:incoming>Flow_CatalogApproved_to_ReviewTask</bpmn:incoming>
      <bpmn:outgoing>Flow_Parallel_to_OpsReview</bpmn:outgoing>
      <bpmn:outgoing>Flow_Parallel_to_PriceCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="Task_OpsReviewListings" name="Ops: Review Product Listings">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition assignee="operations-team" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Parallel_to_OpsReview</bpmn:incoming>
      <bpmn:outgoing>Flow_OpsReview_to_Join</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_PriceValidation" name="System: Price Compliance Check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-product-catalog" retries="2" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Parallel_to_PriceCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_PriceCheck_to_Join</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Parallel Join -->
    <bpmn:parallelGateway id="GW_ParallelJoin" name="All Reviews Complete">
      <bpmn:incoming>Flow_OpsReview_to_Join</bpmn:incoming>
      <bpmn:incoming>Flow_PriceCheck_to_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_to_Publish</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_PublishProducts" name="Publish Products to Marketplace">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-products" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="=sellerId" target="sellerId" />
          <zeebe:output source="=publishedCount" target="publishedCount" />
          <zeebe:output source="=publishStatus" target="publishStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join_to_Publish</bpmn:incoming>
      <bpmn:outgoing>Flow_Publish_to_Activate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ActivateStore" name="Activate Seller Store">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="activate-seller-store" retries="2" />
        <zeebe:ioMapping>
          <zeebe:input source="=sellerId" target="sellerId" />
          <zeebe:output source="=storeActivated" target="storeActivated" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Publish_to_Activate</bpmn:incoming>
      <bpmn:outgoing>Flow_Activate_to_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_CatalogApproved" name="Catalog Published">
      <bpmn:incoming>Flow_Activate_to_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_CatalogRejected" name="Catalog Rejected">
      <bpmn:incoming>Flow_CatalogRejected_to_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_CatalogStart_to_Upload" sourceRef="StartEvent_CatalogReview" targetRef="Task_UploadCatalog" />
    <bpmn:sequenceFlow id="Flow_Upload_to_ValidateMulti" sourceRef="Task_UploadCatalog" targetRef="SubProcess_ValidateProducts" />
    <bpmn:sequenceFlow id="Flow_ValidateMulti_to_GW_Valid" sourceRef="SubProcess_ValidateProducts" targetRef="GW_CatalogApproved" />
    <bpmn:sequenceFlow id="Flow_CatalogApproved_to_ReviewTask" name="=count(validationResults[catalogValid = false]) = 0" sourceRef="GW_CatalogApproved" targetRef="GW_ParallelReview">
      <bpmn:conditionExpression>=count(validationResults[catalogValid = false]) = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CatalogRejected_to_End" name="=count(validationResults[catalogValid = false]) > 0" sourceRef="GW_CatalogApproved" targetRef="EndEvent_CatalogRejected">
      <bpmn:conditionExpression>=count(validationResults[catalogValid = false]) > 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Parallel_to_OpsReview" sourceRef="GW_ParallelReview" targetRef="Task_OpsReviewListings" />
    <bpmn:sequenceFlow id="Flow_Parallel_to_PriceCheck" sourceRef="GW_ParallelReview" targetRef="Task_PriceValidation" />
    <bpmn:sequenceFlow id="Flow_OpsReview_to_Join" sourceRef="Task_OpsReviewListings" targetRef="GW_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_PriceCheck_to_Join" sourceRef="Task_PriceValidation" targetRef="GW_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_Join_to_Publish" sourceRef="GW_ParallelJoin" targetRef="Task_PublishProducts" />
    <bpmn:sequenceFlow id="Flow_Publish_to_Activate" sourceRef="Task_PublishProducts" targetRef="Task_ActivateStore" />
    <bpmn:sequenceFlow id="Flow_Activate_to_End" sourceRef="Task_ActivateStore" targetRef="EndEvent_CatalogApproved" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_CatalogReview">
    <bpmndi:BPMNPlane id="BPMNPlane_CatalogReview" bpmnElement="Process_CatalogReview">
      <bpmndi:BPMNShape id="StartEvent_CatalogReview_di" bpmnElement="StartEvent_CatalogReview">
        <dc:Bounds x="152" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UploadCatalog_di" bpmnElement="Task_UploadCatalog">
        <dc:Bounds x="240" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_ValidateProducts_di" bpmnElement="SubProcess_ValidateProducts" isExpanded="true">
        <dc:Bounds x="390" y="20" width="400" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_CatalogApproved_di" bpmnElement="GW_CatalogApproved" isMarkerVisible="true">
        <dc:Bounds x="845" y="75" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ParallelReview_di" bpmnElement="GW_ParallelReview">
        <dc:Bounds x="955" y="75" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpsReviewListings_di" bpmnElement="Task_OpsReviewListings">
        <dc:Bounds x="1060" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PriceValidation_di" bpmnElement="Task_PriceValidation">
        <dc:Bounds x="1060" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_ParallelJoin_di" bpmnElement="GW_ParallelJoin">
        <dc:Bounds x="1215" y="75" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PublishProducts_di" bpmnElement="Task_PublishProducts">
        <dc:Bounds x="1320" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ActivateStore_di" bpmnElement="Task_ActivateStore">
        <dc:Bounds x="1470" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CatalogApproved_di" bpmnElement="EndEvent_CatalogApproved">
        <dc:Bounds x="1622" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CatalogRejected_di" bpmnElement="EndEvent_CatalogRejected">
        <dc:Bounds x="867" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_CatalogStart_to_Upload_di" bpmnElement="Flow_CatalogStart_to_Upload">
        <di:waypoint x="188" y="100" /><di:waypoint x="240" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Upload_to_ValidateMulti_di" bpmnElement="Flow_Upload_to_ValidateMulti">
        <di:waypoint x="340" y="100" /><di:waypoint x="390" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ValidateMulti_to_GW_Valid_di" bpmnElement="Flow_ValidateMulti_to_GW_Valid">
        <di:waypoint x="790" y="100" /><di:waypoint x="845" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CatalogApproved_to_ReviewTask_di" bpmnElement="Flow_CatalogApproved_to_ReviewTask">
        <di:waypoint x="895" y="100" /><di:waypoint x="955" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CatalogRejected_to_End_di" bpmnElement="Flow_CatalogRejected_to_End">
        <di:waypoint x="870" y="125" /><di:waypoint x="885" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Parallel_to_OpsReview_di" bpmnElement="Flow_Parallel_to_OpsReview">
        <di:waypoint x="1005" y="100" /><di:waypoint x="1060" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Parallel_to_PriceCheck_di" bpmnElement="Flow_Parallel_to_PriceCheck">
        <di:waypoint x="1005" y="100" /><di:waypoint x="1060" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OpsReview_to_Join_di" bpmnElement="Flow_OpsReview_to_Join">
        <di:waypoint x="1160" y="80" /><di:waypoint x="1215" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PriceCheck_to_Join_di" bpmnElement="Flow_PriceCheck_to_Join">
        <di:waypoint x="1160" y="180" /><di:waypoint x="1215" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Join_to_Publish_di" bpmnElement="Flow_Join_to_Publish">
        <di:waypoint x="1265" y="100" /><di:waypoint x="1320" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Publish_to_Activate_di" bpmnElement="Flow_Publish_to_Activate">
        <di:waypoint x="1420" y="100" /><di:waypoint x="1470" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Activate_to_End_di" bpmnElement="Flow_Activate_to_End">
        <di:waypoint x="1570" y="100" /><di:waypoint x="1622" y="100" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
