<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_MarketplaceOnboarding" targetNamespace="https://example.com/marketplace-onboarding">
<bpmn:process id="Process_Onboarding" name="Marketplace Seller &amp; Catalog Onboarding" isExecutable="true">
  <bpmn:laneSet id="LaneSet_1">
  <bpmn:lane id="Lane_Seller" name="Seller">
      <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_SubmitDetails</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_UploadCatalog</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_CorrectProduct</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_ResubmitCatalog</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
    </bpmn:lane>
  <bpmn:lane id="Lane_Ops" name="Marketplace Operations Team">
      <bpmn:flowNodeRef>Task_ReviewApplication</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_DetailsValid</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_RequestInfo</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_VerifyDocuments</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_SellerApproved</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_RejectSeller</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_ReviewListings</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_CatalogApproved</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_RequestCorrections</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
    </bpmn:lane>
  <bpmn:lane id="Lane_System" name="Marketplace System">
      <bpmn:flowNodeRef>Task_CreateAccount</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_NotifyApproval</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_ValidateCatalog</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Gateway_CatalogValid</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_ShowErrors</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_PublishProducts</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Task_ActivateStore</bpmn:flowNodeRef>
    </bpmn:lane>
  </bpmn:laneSet>
  <bpmn:startEvent id="StartEvent_1" name="Seller begins registration" />
  <bpmn:userTask id="Task_Register" name="Register on marketplace" />
  <bpmn:userTask id="Task_SubmitDetails" name="Submit seller details and documents" />
  <bpmn:userTask id="Task_ReviewApplication" name="Review seller application" />
  <bpmn:exclusiveGateway id="Gateway_DetailsValid" name="Seller details valid?" />
  <bpmn:userTask id="Task_RequestInfo" name="Request additional information" />
  <bpmn:userTask id="Task_VerifyDocuments" name="Verify submitted documents" />
  <bpmn:exclusiveGateway id="Gateway_SellerApproved" name="Seller approved?" />
  <bpmn:userTask id="Task_RejectSeller" name="Reject seller application" />
  <bpmn:serviceTask id="Task_CreateAccount" name="Create seller account" />
  <bpmn:serviceTask id="Task_NotifyApproval" name="Send approval notification" />
  <bpmn:userTask id="Task_UploadCatalog" name="Upload product catalog" />
  <bpmn:serviceTask id="Task_ValidateCatalog" name="Validate product data" />
  <bpmn:exclusiveGateway id="Gateway_CatalogValid" name="Catalog data valid?" />
  <bpmn:serviceTask id="Task_ShowErrors" name="Display validation errors" />
  <bpmn:userTask id="Task_CorrectProduct" name="Correct product information" />
  <bpmn:userTask id="Task_ResubmitCatalog" name="Resubmit product catalog" />
  <bpmn:userTask id="Task_ReviewListings" name="Review product listings" />
  <bpmn:exclusiveGateway id="Gateway_CatalogApproved" name="Catalog approved?" />
  <bpmn:userTask id="Task_RequestCorrections" name="Request catalog corrections" />
  <bpmn:serviceTask id="Task_PublishProducts" name="Publish product listings" />
  <bpmn:serviceTask id="Task_ActivateStore" name="Activate seller store" />
  <bpmn:endEvent id="End_Success" name="Onboarding complete" />
  <bpmn:endEvent id="End_Rejected" name="Seller application rejected" />
  <bpmn:sequenceFlow id="F01" sourceRef="StartEvent_1" targetRef="Task_Register" />
  <bpmn:sequenceFlow id="F02" sourceRef="Task_Register" targetRef="Task_SubmitDetails" />
  <bpmn:sequenceFlow id="F03" sourceRef="Task_SubmitDetails" targetRef="Task_ReviewApplication" />
  <bpmn:sequenceFlow id="F04" sourceRef="Task_ReviewApplication" targetRef="Gateway_DetailsValid" />
  <bpmn:sequenceFlow id="F05" sourceRef="Gateway_DetailsValid" targetRef="Task_RequestInfo" name="No" />
  <bpmn:sequenceFlow id="F06" sourceRef="Task_RequestInfo" targetRef="Task_SubmitDetails" />
  <bpmn:sequenceFlow id="F07" sourceRef="Gateway_DetailsValid" targetRef="Task_VerifyDocuments" name="Yes" />
  <bpmn:sequenceFlow id="F08" sourceRef="Task_VerifyDocuments" targetRef="Gateway_SellerApproved" />
  <bpmn:sequenceFlow id="F09" sourceRef="Gateway_SellerApproved" targetRef="Task_RejectSeller" name="No" />
  <bpmn:sequenceFlow id="F10" sourceRef="Task_RejectSeller" targetRef="End_Rejected" />
  <bpmn:sequenceFlow id="F11" sourceRef="Gateway_SellerApproved" targetRef="Task_CreateAccount" name="Yes" />
  <bpmn:sequenceFlow id="F12" sourceRef="Task_CreateAccount" targetRef="Task_NotifyApproval" />
  <bpmn:sequenceFlow id="F13" sourceRef="Task_NotifyApproval" targetRef="Task_UploadCatalog" />
  <bpmn:sequenceFlow id="F14" sourceRef="Task_UploadCatalog" targetRef="Task_ValidateCatalog" />
  <bpmn:sequenceFlow id="F15" sourceRef="Task_ValidateCatalog" targetRef="Gateway_CatalogValid" />
  <bpmn:sequenceFlow id="F16" sourceRef="Gateway_CatalogValid" targetRef="Task_ShowErrors" name="No" />
  <bpmn:sequenceFlow id="F17" sourceRef="Task_ShowErrors" targetRef="Task_CorrectProduct" />
  <bpmn:sequenceFlow id="F18" sourceRef="Task_CorrectProduct" targetRef="Task_ResubmitCatalog" />
  <bpmn:sequenceFlow id="F19" sourceRef="Task_ResubmitCatalog" targetRef="Task_ValidateCatalog" />
  <bpmn:sequenceFlow id="F20" sourceRef="Gateway_CatalogValid" targetRef="Task_ReviewListings" name="Yes" />
  <bpmn:sequenceFlow id="F21" sourceRef="Task_ReviewListings" targetRef="Gateway_CatalogApproved" />
  <bpmn:sequenceFlow id="F22" sourceRef="Gateway_CatalogApproved" targetRef="Task_RequestCorrections" name="No" />
  <bpmn:sequenceFlow id="F23" sourceRef="Task_RequestCorrections" targetRef="Task_CorrectProduct" />
  <bpmn:sequenceFlow id="F24" sourceRef="Gateway_CatalogApproved" targetRef="Task_PublishProducts" name="Yes" />
  <bpmn:sequenceFlow id="F25" sourceRef="Task_PublishProducts" targetRef="Task_ActivateStore" />
  <bpmn:sequenceFlow id="F26" sourceRef="Task_ActivateStore" targetRef="End_Success" />
</bpmn:process>
